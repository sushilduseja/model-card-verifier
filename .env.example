# === Provider Keys ===
GROQ_API_KEY=<your_groq_api_key>
NVIDIA_API_KEY=<your_nvidia_nim_key>

# === Pipeline Roles ===
# Extractor and Tester use Groq for speed/free-tier efficiency
MODEL_EXTRACTOR=groq/llama-3.3-70b-versatile
MODEL_TESTER=groq/llama-3.3-70b-versatile

# Audit and Judge use NVIDIA NIM for high-performance compliance testing
MODEL_UNDER_AUDIT=nvidia/mistralai/mistral-7b-instruct-v0.2
MODEL_JUDGE=nvidia/meta/llama-3.1-70b-instruct

# === Fallbacks ===
# If NIM judge fails, fall back to a smaller/faster NIM model — same provider, no extra account
FALLBACK_MODELS=nvidia/meta/llama-3.1-8b-instruct

# === Other Config ===
HF_TOKEN=<hf_read_token>
HF_USERNAME=<hf_username>
LLM_TIMEOUT_SECONDS=30
CONFIRM_CLAIMS=false
