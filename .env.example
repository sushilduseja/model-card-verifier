GROQ_API_KEY=<groq key>
GEMINI_API_KEY=<gemini api key>
# GOOGLE_API_KEY=<google api key alias, optional if GEMINI_API_KEY is set>
# NVIDIA_API_KEY=<nvidia nim key>   # disabled for now
OPENCODE_ZEN_API_BASE=https://opencode.ai/zen/v1   # or exact base from OpenCode docs
ZEN_API_BASE=https://opencode.ai/zen/v1             # add this — _call_llm reads ZEN_API_BASE
OPENCODE_ZEN_MODELS=minimax-m2.5,big-pickle-v1
MODEL_UNDER_AUDIT=mistralai/Mistral-7B-Instruct-v0.2
MODEL_EXTRACTOR=groq/llama-3.3-70b-versatile
MODEL_TESTER=groq/llama-3.3-70b-versatile
MODEL_JUDGE=minimax-m2.5
FALLBACK_MODELS=gemini/gemini-2.5-flash,gemini/gemini-2.5-flash-lite,gemini/gemini-flash-lite-latest
# FALLBACK_MODEL=gemini/gemini-2.5-flash   # optional legacy single fallback
AUDIT_API_KEY=<zen key>
AUDIT_API_BASE=https://opencode.ai/zen/v1
EXTRACTOR_API_KEY=<groq key>
TESTER_API_KEY=<groq key>
JUDGE_API_KEY=<zen key>
HF_TOKEN=<hf write token>
HF_USERNAME=<hf username>
LLM_TIMEOUT_SECONDS=45
