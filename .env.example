# === Provider Keys ===
GROQ_API_KEY=<your_groq_api_key>
NVIDIA_API_KEY=<your_nvidia_nim_key>

# === Model Card Source ===
AUDIT_HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# === Pipeline Roles ===
# Extraction (Groq 8B — single call, no rate limit issue)
MODEL_EXTRACTOR=groq/llama-3.1-8b-instant
# Test gen + inference + judge (Nemotron 3 Nano 30B — reliable, no rate limits, 2-5s)
MODEL_TESTER=nvidia/nvidia/nemotron-3-nano-30b-a3b
MODEL_UNDER_AUDIT=nvidia/nvidia/nemotron-3-nano-30b-a3b
MODEL_JUDGE=nvidia/nvidia/nemotron-3-nano-30b-a3b

# === Fallback ===
FALLBACK_MODELS=groq/llama-3.3-70b-versatile,nvidia/meta/llama-3.1-70b-instruct

# === Performance ===
LLM_TIMEOUT_SECONDS=90
RUN_WORKERS=2
SCORE_WORKERS=2
CONFIRM_CLAIMS=false